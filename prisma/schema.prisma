generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id           String        @id @default(cuid())
  type         String        @default("STUDENT")
  name         String?
  phone        String?
  email        String?
  intent       String?
  source       String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  background   String?
  insights     String?
  nextSteps    String?
  sourceAI     String?
  interactions Interaction[]
  meetings     Meeting[]
}

model Interaction {
  id         String   @id @default(cuid())
  customerId String
  type       String   @default("AI_CHAT")
  summary    String?
  messages   String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  title     String
  content   String?
  category  String?
  audience  String?
  type      String   @default("FILE") // "FILE" or "FOLDER"
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    KnowledgeItem?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  KnowledgeItem[] @relation("FolderHierarchy")
}

model Staff {
  id    String  @id @default(cuid())
  name  String
  role  String  @default("SECRETARY")
  email String?
}

model Meeting {
  id          String    @id @default(cuid())
  customerId  String?
  subject     String
  startTime   DateTime
  endTime     DateTime
  location    String?
  description String?
  status      String    @default("SCHEDULED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  role         String       @default("user") // "admin" | "user"
  displayName  String?
  phone        String?
  email        String?
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  taskContexts TaskContext[]
}

model TaskContext {
  id              String   @id @default(cuid())
  source          String
  rawContent      String
  parsedData      String?
  attachments    String?          // JSON: AttachmentMeta[] from upload
  modelUsed       String?
  userId          String?
  approvalConfig  String?          // JSON: ["Alice", "Eric"] — agents that require approval
  approvalEmailId String?          // Message-ID for tracking approval email replies
  pipelineStatus  String   @default("ACTIVE") // ACTIVE | AWAITING_APPROVAL | ALL_APPROVED | COMPLETED
  createdAt       DateTime @default(now())
  tasks           Task[]
  user            User?    @relation(fields: [userId], references: [id])
}

model Task {
  id               String      @id @default(cuid())
  contextId        String
  agent            String
  instruction      String
  status           String      @default("PENDING")
  requiresApproval Boolean     @default(false)
  resultPayload    String?
  attachmentIds    String?        // JSON: string[] of attachment IDs for this task
  phase            Int     @default(1)  // Execution phase: 1, 2, 3
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  copilotHistory   String?
  thinkLog         String?
  toolCallsLog     String?
  context          TaskContext @relation(fields: [contextId], references: [id])
}

model GroupChat {
  id           String                 @id @default(cuid())
  name           String
  topic          String?
  responseLength String                 @default("moderate") // short, moderate, detailed, unlimited
  speakingOrder  String[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  participants GroupChatParticipant[]
  messages     GroupChatMessage[]
}

model GroupChatParticipant {
  id          String    @id @default(cuid())
  groupChatId String
  agentId     String    // e.g. "alice", "bob", "USER"
  joinedAt    DateTime  @default(now())
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)

  @@unique([groupChatId, agentId])
}

model GroupChatMessage {
  id          String    @id @default(cuid())
  groupChatId String
  senderId    String    // The agentId or "USER"
  role        String    // "user" | "ai" | "system"
  content     String
  thinkLog    String?
  toolCalls   String?   // JSON string to store execution requests/results
  createdAt   DateTime  @default(now())
  groupChat   GroupChat @relation(fields: [groupChatId], references: [id], onDelete: Cascade)
}

model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AgentMemory {
  id         String   @id @default(cuid())
  agentId    String
  type       String   // task_feedback, lesson_learned, user_preference, task_summary, copilot_feedback, dreaming_insight
  source     String   // user, self, system, dreaming
  content    String
  importance Float    @default(0.5)
  taskId     String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([agentId, importance])
}

model AgentSoul {
  agentId   String   @id
  content   String
  updatedAt DateTime @updatedAt
}
