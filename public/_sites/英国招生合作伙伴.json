    {
      "id": "services",
      "title": "业务展示",
      "html": "<section class=\"min-h-screen bg-white py-16 md:py-24\">\n  <div class=\"container mx-auto px-6\">\n    <h2 class=\"text-3xl md:text-4xl font-bold text-center text-gray-800 mb-16\">我们的核心业务</h2>\n    \n    <div class=\"grid md:grid-cols-3 gap-8\">\n      <div class=\"bg-blue-50 rounded-xl p-8 hover:shadow-lg transition\">\n        <div class=\"text-blue-600 text-4xl mb-4\">🎓</div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-3\">本科申请</h3>\n        <p class=\"text-gray-600\">提供英国TOP50大学本科申请服务，包括UCAS系统指导、文书润色、面试培训等全方位支持。</p>\n      </div>\n      \n      <div class=\"bg-blue-50 rounded-xl p-8 hover:shadow-lg transition\">\n        <div class=\"text-blue-600 text-4xl mb-4\">📚</div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-3\">研究生申请</h3>\n        <p class=\"text-gray-600\">专业研究生申请团队，针对G5等顶尖院校提供定制化申请方案，提高录取成功率。</p>\n      </div>\n      \n      <div class=\"bg-blue-50 rounded-xl p-8 hover:shadow-lg transition\">\n        <div class=\"text-blue-600 text-4xl mb-4\">🏫</div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-3\">中学留学</h3>\n        <p class=\"text-gray-600\">英国顶尖私立中学申请服务，包括访校安排、入学考试辅导、监护人安排等一站式服务。</p>\n      </div>\n    </div>\n    \n    <div class=\"mt-16\">\n      <h3 class=\"text-2xl font-bold text-gray-800 mb-6\">成功案例</h3>\n      <div class=\"grid md:grid-cols-2 gap-8\">\n        <div class=\"relative group cursor-pointer\" data-image-placeholder=\"true\">\n          <div class=\"bg-gradient-to-br from-gray-200 to-gray-300 rounded-xl flex items-center justify-center\" style=\"height:240px\">\n            <div class=\"text-center\"><div class=\"text-4xl mb-2\">📷</div><div class=\"text-sm text-gray-500\">点击替换图片</div></div>\n          </div>\n        </div>\n        <div>\n          <h4 class=\"text-xl font-bold text-gray-800 mb-3\">2023年录取成果</h4>\n          <ul class=\"text-gray-600 space-y-2\">\n            <li>• 牛津剑桥录取率32%</li>\n            <li>• G5大学录取率78%</li>\n            <li>• 英国TOP10大学录取率92%</li>\n          