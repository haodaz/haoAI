om-gray-200 to-gray-300 flex items-center justify-center\" style=\"height:240px\">\n            <div class=\"text-center\"><div class=\"text-4xl mb-2\">📷</div><div class=\"text-sm text-gray-500\">点击替换图片</div></div>\n          </div>\n        </div>\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-bold text-gray-800 mb-1\">王老师</h3>\n          <p class=\"text-blue-600 mb-3\">中学留学顾问</p>\n          <p class=\"text-gray-600 text-sm\">伊顿公学前招生官，15年英国私立中学申请经验，熟悉顶尖私校录取标准。</p>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"mt-16 bg-white rounded-xl p-8 shadow-md\">\n      <h3 class=\"text-2xl font-bold text-gray-800 mb-6\">我们的优势</h3>\n      <ul class=\"text-gray-600 space-y-4\">\n        <li class=\"flex items-start\">\n          <div class=\"text-blue-600 mr-3\">✓</div>\n          <div>100%英国本土顾问团队，掌握最新招生政策</div>\n        </li>\n        <li class=\"flex items-start\">\n          <div class=\"text-blue-600 mr-3\">✓</div>\n          <div>与100+英国院校保持官方合作关系</div>\n        </li>\n        <li class=\"flex items-start\">\n          <div class=\"text-blue-600 mr-3\">✓</div>\n          <div>全程透明服务，申请进度实时可查</div>\n        </li>\n        <li class=\"flex items-start\">\n          <div class=\"text-blue-600 mr-3\">✓</div>\n          <div>提供抵英后的学业生活全方位支持</div>\n        </li>\n      </ul>\n    </div>\n  </div>\n</section>",
